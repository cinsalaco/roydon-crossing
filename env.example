# Realtime Trains next-generation API (https://api-portal.rtt.io)
RTT_TOKEN=your-token-here
# "access" (default) or "refresh" - the portal tells you which kind you were given
RTT_TOKEN_TYPE=access
# Location to track (short CRS or TIPLOC)
RTT_LOCATION=RYN
# Optional: pin an API version, e.g. 2026-04-09. Leave blank for latest.
RTT_API_VERSION=
# Poll frequency in seconds and lookahead window in minutes
POLL_INTERVAL=60
WINDOW_MINUTES=120
